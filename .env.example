# Configuración de la base de datos
MONGODB_URI=mongodb://localhost:27017/apollonia_db
DOCKER_MONGODB_URI=mongodb://mongodb:27017/apollonia_db

# MongoDB Atlas (Cloud) - Reemplaza con tu URL cuando tengas cuenta
MONGODB_ATLAS_URI=mongodb+srv://username:password@cluster0.xxxxx.mongodb.net/apollonia_db?retryWrites=true&w=majority

# Configuración del servidor
PORT=3000
NODE_ENV=development

# Configuración de la aplicación
APP_NAME=Apollonia Employee Management
APP_VERSION=1.0.0

# Configuración de conexión
DB_CONNECTION_TIMEOUT=30000
DB_RECONNECT_ATTEMPTS=3
