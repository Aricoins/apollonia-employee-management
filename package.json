{
  "name": "apollonia-employee-management",
  "version": "1.0.0",
  "description": "Employee Management System for Apollonia Dental Practice",
  "main": "server.js",
  "engines": {
    "node": ">=18.0.0"
  },
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "init-db": "node init-database.js",
    "menu": "node start.js",
    "demo": "node demo.js",
    "local": "cross-env NODE_ENV=development MONGODB_URI=mongodb://localhost:27017/apollonia_db node server.js",
    "atlas": "cross-env NODE_ENV=production node server.js",
    "docker": "cross-env NODE_ENV=docker MONGODB_URI=mongodb://mongodb:27017/apollonia_db node server.js",
    "test": "echo \"Error: no test specified\" && exit 1"
  },
  "keywords": [
    "nodejs",
    "express",
    "mongodb",
    "crud",
    "dental",
    "employee-management"
  ],
  "author": "Tu Nombre",
  "license": "MIT",
  "dependencies": {
    "cors": "^2.8.5",
    "dotenv": "^16.0.3",
    "express": "^4.18.2",
    "express-validator": "^7.0.1",
    "mongoose": "^7.0.3",
    "@vercel/analytics": "^1.1.1"
  },
  "devDependencies": {
    "nodemon": "^3.0.1"
  }
}
